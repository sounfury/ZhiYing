# ──────────────────────────────────────────────
# CastAtlas 后端配置 — 复制为 .env 并按需修改
# ──────────────────────────────────────────────

# ── LLM (OpenAI 兼容) ──
# 任意 OpenAI 兼容端点：官方 / 中转 / 本地 Ollama / vLLM 等
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
# Reconcile / 终局归纳可用不同模型（留空则与 LLM_MODEL 相同）
LLM_RECONCILE_MODEL=

# ── Workspace ──
# 书籍数据落盘根目录（默认项目根下的 workspace/）
WORKSPACE_ROOT=

# ── 分析参数 ──
# 单章 Agent 工具调用步数上限
MAX_AGENT_STEPS=20
# 并行章分析数上限（LLM 并发闸）
MAX_PARALLEL_CHAPTERS=5

# ── few_long 模式阈值 ──
# 章数 <= 此值且单章字数足够大 → few_long 模式
K_FEW_CHAPTERS=8
W_HUGE_CHAPTER_WORDS=8000
W_LARGE_CHAPTER_WORDS=4000

# ── 服务 ──
HOST=0.0.0.0
PORT=8000
DEBUG=true