{
  "minLines": 5,
  "minTokens": 50,
  "threshold": 0,
  "mode": "mild",
  "noGitignore": true,
  "maxSize": "1gb",
  "reporters": ["json", "console", "threshold"],
  "absolute": true,
  "failOnEmpty": true,
  "ignorePattern": [
    "(?m)^import\\s+.+$",
    "(?m)^package\\s+.+$"
  ],
  "ignore": [
    "**/.git/**",
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/.venv/**",
    "**/venv/**",
    "**/build/**",
    "**/.gradle/**",
    "**/dist/**",
    "**/.vite/**",
    "**/*.pyc",
    "**/*.tsbuildinfo",
    "**/package-lock.json",
    "**/.woodpecker/**",
    "**/frontend/**",
    "**/quality/detekt-*.yml",
    "**/web/graph/GraphResponse.kt",
    "**/web/types/RelationTypeController.kt"
  ]
}
