# 模型服务（OpenAI 兼容协议）。复制为 .env 后填写；同名环境变量优先于 .env。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-flash
# 后台新增模型服务商时用来加密其 API Key，任意长随机串（如 openssl rand -base64 32）；不设则后台不能新增服务商。
LLM_SECRET_KEY=

# 首次启动创建管理员；用户名 3–32 位字母/数字/下划线，密码 8–128 字符。
ZHIYING_ADMIN_USERNAME=admin
ZHIYING_ADMIN_PASSWORD=
# 公网 HTTPS 部署设为 true；本地 HTTP 为 false。
ZHIYING_COOKIE_SECURE=false
