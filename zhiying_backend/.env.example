# 后端部署配置。复制为 .env 后填写；同名环境变量优先于 .env。
# 模型服务商、API Key、各分析环节的模型名与思考开关均在管理员后台配置。
# 加密服务商 API Key 的主密钥，使用随机串（如 openssl rand -base64 32）；不设仍可启动，但不能保存或使用服务商密钥。
LLM_SECRET_KEY=

# 首次启动创建管理员；用户名 3–32 位字母/数字/下划线，密码 8–128 字符。
ZHIYING_ADMIN_USERNAME=admin
ZHIYING_ADMIN_PASSWORD=
# 公网 HTTPS 部署设为 true；本地 HTTP 为 false。
ZHIYING_COOKIE_SECURE=false
